// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueTicketStatus {
  WAITING
  CALLED
  DONE
  CANCELLED
}

model Patient {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cpfNormalized String         @unique @map("cpf_normalized") @db.Char(11)
  fullName      String         @map("full_name")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  queueSessions QueueSession[]

  @@map("patients")
}

model QueueSession {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber Int               @map("ticket_number")
  patientId    String            @map("patient_id") @db.Uuid
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status       QueueTicketStatus @default(WAITING)
  calledAt     DateTime?         @map("called_at")
  queueDate    DateTime          @map("queue_date") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([queueDate, ticketNumber])
  @@index([patientId, queueDate])
  @@index([queueDate, status])
  @@map("queue_sessions")
}
