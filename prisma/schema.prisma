// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueTicketStatus {
  WAITING
  CALLED
  DONE
  CANCELLED
}

/** desk_slot = 0 coordenação (master único neste modelo); 1–4 guichês. */
model StaffAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deskSlot     Int      @unique @map("desk_slot")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("staff_accounts")
}

model Patient {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cpfNormalized    String         @unique @map("cpf_normalized") @db.Char(11)
  fullName         String         @map("full_name")
  phoneNormalized  String?        @map("phone_normalized") @db.VarChar(11)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  queueSessions    QueueSession[]

  @@map("patients")
}

model QueueSession {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber Int               @map("ticket_number")
  patientId    String            @map("patient_id") @db.Uuid
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status       QueueTicketStatus @default(WAITING)
  calledAt     DateTime?         @map("called_at")
  /** 1–4 quando a senha foi chamada pelo guichê correspondente */
  calledGuiche Int?              @map("called_guiche")
  queueDate    DateTime          @map("queue_date") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([queueDate, ticketNumber])
  @@index([patientId, queueDate])
  @@index([queueDate, status])
  @@map("queue_sessions")
}
